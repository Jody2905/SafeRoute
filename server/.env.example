# Neon pooled connection string (host contains -pooler)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Long random secret for sign-in tokens (32+ characters)
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Where the GitHub Pages copy of the site lives
CORS_ORIGIN=https://jody2905.github.io
# Auto-verify new drivers so the demo works without an admin (turn off in real use)
DEMO_MODE=true
# Hours to keep a trip's GPS trail after it ends
LOCATION_RETENTION_HOURS=24
